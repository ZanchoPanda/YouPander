<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        YouPanderStyles.xaml — Estilos base
        Los colores NO están aquí. Vienen de TemaOscuro.xaml o TemaClaro.xaml,
        que se cargan en runtime según la elección del usuario.
        Este archivo solo puede referenciarse DESPUÉS de que un tema esté cargado.
    -->

    <!--
        =============================================
        ESPACIADO Y FORMA
        =============================================
    -->

    <x:Double x:Key="TamanoTextoXS">11</x:Double>
    <x:Double x:Key="TamanoTextoSM">13</x:Double>
    <x:Double x:Key="TamanoTextoMD">15</x:Double>
    <x:Double x:Key="TamanoTextoLG">17</x:Double>
    <x:Double x:Key="TamanoTextoXL">20</x:Double>
    <x:Double x:Key="TamanoTextoXXL">24</x:Double>
    <x:Double x:Key="TamanoTitulo">28</x:Double>

    <Thickness x:Key="PaddingXS">4</Thickness>
    <Thickness x:Key="PaddingSM">8</Thickness>
    <Thickness x:Key="PaddingMD">12,8</Thickness>
    <Thickness x:Key="PaddingLG">16,12</Thickness>
    <Thickness x:Key="PaddingXL">20,16</Thickness>
    <Thickness x:Key="PaddingPagina">16,12</Thickness>


    <!--
        =============================================
        TEXTO — estilos con nombre
        =============================================
    -->

    <Style x:Key="TextoBase" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoMD}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="TextoSecundario" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoSecundario}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoSM}" />
    </Style>

    <Style x:Key="TextoSubtitulo" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoSecundario}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoXS}" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="TextoAcento" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoAcento}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoSM}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="TituloSeccion" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoXL}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="TituloPagina" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTitulo}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="TextoEstadoVacio" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoDeshabilitado}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoMD}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="32" />
    </Style>


    <!--
        =============================================
        LAYOUT Y CONTENEDORES
        =============================================
    -->

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBordeSutil}" />
        <Setter Property="Padding" Value="{StaticResource PaddingLG}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="TarjetaElevada" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoElevado}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBordeNormal}" />
        <Setter Property="Padding" Value="{StaticResource PaddingLG}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>

    <Style x:Key="TarjetaItem" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBordeSutil}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Separador" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="0.5" />
        <Setter Property="Color" Value="{DynamicResource ColorBordeSutil}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <Style x:Key="EntradaBorde" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBordeNormal}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="14,0" />
    </Style>


    <!--
        =============================================
        BOTONES
        =============================================
    -->

    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoMD}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorTextoDeshabilitado}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoMD}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource ColorTextoDeshabilitado}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="BotonFantasma" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoAcento}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoSM}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="BotonIcono" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="BotonPlay" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource ColorError}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoSM}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorError}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>


    <!--
        =============================================
        CONTROLES MULTIMEDIA
        =============================================
    -->

    <Style x:Key="SliderReproductor" TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="ThumbColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="HeightRequest" Value="20" />
    </Style>

    <Style x:Key="IndicadorCarga" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource ColorAcento}" />
    </Style>


    <!--
        =============================================
        ESTILOS IMPLÍCITOS
        Usan DynamicResource para reaccionar al cambio de tema en runtime
        =============================================
    -->

    <Style ApplyToDerivedTypes="True" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoPrincipal}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="FontSize" Value="{StaticResource TamanoTextoMD}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextoDeshabilitado}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextoDeshabilitado}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="TitleColor" Value="{DynamicResource ColorTextoSecundario}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="ThumbColor" Value="{DynamicResource ColorAcento}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="ThumbColor" Value="#FFFFFF" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource ColorAcento}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource ColorAcento}" />
    </Style>

    <Style TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorBordeSutil}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBordeSutil}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextoDeshabilitado}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource ColorTextoSecundario}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="Background" Value="{DynamicResource ColorFondoPrincipal}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource ColorBordeSutil}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource ColorAcento}" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoPrincipal}" />
    </Style>

    <Style ApplyToDerivedTypes="True" TargetType="Shell">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource ColorTextoDeshabilitado}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource ColorTextoSecundario}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource ColorAcento}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource ColorTextoSecundario}" />
    </Style>

</ResourceDictionary>
