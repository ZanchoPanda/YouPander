<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  ==========================================  -->
    <!--  CONTROLES GENERALES  -->
    <!--  ==========================================  -->

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource ColorAcentoOscuro}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{DynamicResource ColorBordeNormal}" />
        <Setter Property="SelectedIndicatorColor" Value="{DynamicResource ColorAcentoOscuro}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBordeSutil}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource ColorBordeSutil}" />
    </Style>

    <!--  ==========================================  -->
    <!--  BOTONES  -->
    <!--  ==========================================  -->

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorAcentoOscuro}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorTextoDeshabilitado}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--  ==========================================  -->
    <!--  CHECKBOX Y RADIO  -->
    <!--  ==========================================  -->

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource ColorAcentoOscuro}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!--  ==========================================  -->
    <!--  FECHA Y HORA  -->
    <!--  ==========================================  -->

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!--  ==========================================  -->
    <!--  ENTRY Y EDITOR  -->
    <!--  ==========================================  -->

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextoSecundario}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextoSecundario}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--  ==========================================  -->
    <!--  LABELS  -->
    <!--  ==========================================  -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SubHeadline" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!--  ==========================================  -->
    <!--  PICKER  -->
    <!--  ==========================================  -->

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="TitleColor" Value="{DynamicResource ColorTextoSecundario}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!--  ==========================================  -->
    <!--  IMÁGENES  -->
    <!--  ==========================================  -->

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <!--  ==========================================  -->
    <!--  PROGRESS BAR  -->
    <!--  ==========================================  -->

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource ColorAcentoOscuro}" />
    </Style>

    <!--  ==========================================  -->
    <!--  REFRESH  -->
    <!--  ==========================================  -->

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource ColorAcentoOscuro}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoPrincipal}" />
    </Style>

    <!--  ==========================================  -->
    <!--  SEARCH  -->
    <!--  ==========================================  -->

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPrimario}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextoSecundario}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource ColorTextoSecundario}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoControl}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--  ==========================================  -->
    <!--  SHADOW  -->
    <!--  ==========================================  -->

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="10" />
        <Setter Property="Opacity" Value="0.15" />
        <Setter Property="Brush" Value="#000000" />
        <Setter Property="Offset" Value="0,3" />
    </Style>

    <!--  ==========================================  -->
    <!--  SLIDER  -->
    <!--  ==========================================  -->

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource ColorAcentoOscuro}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource ColorBordeNormal}" />
        <Setter Property="ThumbColor" Value="{DynamicResource ColorAcentoOscuro}" />
    </Style>

    <!--  ==========================================  -->
    <!--  SWITCH  -->
    <!--  ==========================================  -->

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource ColorAcentoOscuro}" />
        <Setter Property="ThumbColor" Value="#FFFFFF" />
    </Style>

    <!--  ==========================================  -->
    <!--  SWIPE  -->
    <!--  ==========================================  -->

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />
    </Style>

    <!--  ==========================================  -->
    <!--  PÁGINAS  -->
    <!--  ==========================================  -->

    <Style ApplyToDerivedTypes="True" TargetType="Page">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoPrincipal}" />
    </Style>

    <!--  ==========================================  -->
    <!--  SHELL / MENÚ DE NAVEGACIÓN  -->
    <!--  ==========================================  -->

    <Style ApplyToDerivedTypes="True" TargetType="Shell">

        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />

        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource ColorTextoPrimario}" />

        <Setter Property="Shell.TitleColor" Value="{DynamicResource ColorTextoPrimario}" />

        <Setter Property="Shell.DisabledColor" Value="{DynamicResource ColorTextoDeshabilitado}" />

        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource ColorTextoSecundario}" />

        <Setter Property="Shell.NavBarHasShadow" Value="False" />

        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />

        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource ColorAcento}" />

        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource ColorTextoPrimario}" />

        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource ColorTextoSecundario}" />

    </Style>

    <!--  ==========================================  -->
    <!--  NAVIGATION  -->
    <!--  ==========================================  -->

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />
        <Setter Property="BarTextColor" Value="{DynamicResource ColorTextoPrimario}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource ColorFondoSuperficie}" />
        <Setter Property="BarTextColor" Value="{DynamicResource ColorAcentoOscuro}" />
        <Setter Property="UnselectedTabColor" Value="{DynamicResource ColorTextoSecundario}" />
        <Setter Property="SelectedTabColor" Value="{DynamicResource ColorAcentoOscuro}" />
    </Style>

</ResourceDictionary>
