<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="YouPander.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local2="clr-namespace:YouPander.Services"
    xmlns:resx="clr-namespace:YouPander.Resources.Localization"
    xmlns:sys="clr-namespace:System.Diagnostics;assembly=System.Runtime"
    Title=""
    BackgroundColor="{DynamicResource ColorFondoPrincipal}">

    <Grid RowDefinitions="Auto,*">

        <!--  ======================================  -->
        <!--  CABECERA Y BUSCADOR  -->
        <!--  ======================================  -->

        <VerticalStackLayout
            Grid.Row="0"
            Padding="16,12,16,8"
            Spacing="14">

            <!--  LOGO  -->
            <Image
                Aspect="AspectFit"
                HorizontalOptions="Center"
                IsVisible="{Binding Source={x:Static sys:Debugger.IsAttached}, Converter={StaticResource InverseBoolConverter}}"
                MaximumHeightRequest="160"
                MaximumWidthRequest="160"
                MinimumHeightRequest="100"
                MinimumWidthRequest="100"
                Source="imageyoupander.png"
                VerticalOptions="Center" />

            <!--  BUSCADOR  -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                <Border
                    Grid.Column="0"
                    Padding="10,0"
                    BackgroundColor="{DynamicResource ColorFondoControl}"
                    Stroke="{DynamicResource ColorBordeNormal}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">

                    <Entry
                        BackgroundColor="Transparent"
                        Placeholder="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[URLToDownload]}"
                        PlaceholderColor="{DynamicResource ColorTextoSecundario}"
                        ReturnCommand="{Binding SearchCommand}"
                        Text="{Binding Url}"
                        TextColor="{DynamicResource ColorTextoPrimario}" />

                </Border>

                <Button
                    Grid.Column="1"
                    BackgroundColor="{DynamicResource ColorAcentoOscuro}"
                    Command="{Binding SearchCommand}"
                    CornerRadius="12"
                    HeightRequest="48"
                    IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}"
                    Text="🔍"
                    TextColor="#FFFFFF"
                    WidthRequest="50" />

            </Grid>

            <!--  SELECTOR DE FORMATO  -->
            <Border
                Padding="10,2"
                BackgroundColor="{DynamicResource ColorFondoControl}"
                IsVisible="{Binding ShowVideoList}"
                Stroke="{DynamicResource ColorBordeNormal}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">

                <Picker
                    Title="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[Type]}"
                    BackgroundColor="Transparent"
                    ItemDisplayBinding="{Binding Label}"
                    ItemsSource="{Binding AvailableFormats}"
                    SelectedItem="{Binding SelectedFormatOption}"
                    TextColor="{DynamicResource ColorTextoPrimario}"
                    TitleColor="{DynamicResource ColorTextoSecundario}" />

            </Border>

            <!--  INDICADOR DE BÚSQUEDA  -->
            <VerticalStackLayout
                Padding="0,4"
                IsVisible="{Binding IsSearching}"
                Spacing="6">

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsSearching}"
                    Color="{DynamicResource ColorAcentoOscuro}" />

                <Label
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="{Binding Status}"
                    TextColor="{DynamicResource ColorTextoSecundario}" />

            </VerticalStackLayout>

            <!--  ESTADO  -->
            <Label
                FontSize="13"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding ShowVideoList, Converter={StaticResource InverseBoolConverter}}"
                Text="{Binding Status}"
                TextColor="{DynamicResource ColorTextoSecundario}" />

            <!--  ERRORES  -->
            <Border
                Padding="12"
                BackgroundColor="{DynamicResource ColorFondoSuperficie}"
                IsVisible="{Binding HasError}"
                Stroke="{DynamicResource ColorError}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">

                <Label
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    Text="{Binding ErrorMessage}"
                    TextColor="{DynamicResource ColorError}" />

            </Border>

        </VerticalStackLayout>

        <!--  ======================================  -->
        <!--  RESULTADOS DE BÚSQUEDA  -->
        <!--  ======================================  -->

        <Grid
            Grid.Row="1"
            IsVisible="{Binding ShowVideoList}"
            RowDefinitions="*,Auto">

            <CollectionView
                x:Name="MyCollectionView"
                Grid.Row="0"
                Margin="12,6"
                ItemsSource="{Binding VideoItems}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <!--  TARJETA DE VÍDEO  -->
                        <Border
                            Margin="0,4"
                            Padding="10"
                            BackgroundColor="{DynamicResource ColorFondoSuperficie}"
                            Stroke="{DynamicResource ColorBordeSutil}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">

                            <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="12">

                                <!--  MINIATURA  -->
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="{DynamicResource ColorFondoControl}"
                                    HeightRequest="110"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0">

                                    <Image Aspect="AspectFill" Source="{Binding ThumbnailUrl}" />

                                </Border>

                                <!--  INFORMACIÓN  -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="6"
                                    VerticalOptions="Center">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Title}"
                                        TextColor="{DynamicResource ColorTextoPrimario}" />

                                    <Label
                                        FontSize="12"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding Channel}"
                                        TextColor="{DynamicResource ColorTextoSecundario}" />

                                    <Label
                                        FontSize="11"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding Url}"
                                        TextColor="{DynamicResource ColorTextoAcento}" />

                                    <!--  PROGRESO  -->
                                    <ProgressBar
                                        Margin="0,5,0,0"
                                        HeightRequest="5"
                                        Progress="{Binding Progress}"
                                        ProgressColor="{DynamicResource ColorAcentoOscuro}" />

                                </VerticalStackLayout>

                                <!--  ACCIONES  -->
                                <VerticalStackLayout
                                    Grid.Column="2"
                                    HorizontalOptions="Center"
                                    Spacing="8"
                                    VerticalOptions="Center">

                                    <!--  ABRIR VÍDEO  -->
                                    <ImageButton
                                        Padding="9"
                                        BackgroundColor="{DynamicResource ColorAcentoOscuro}"
                                        Command="{Binding BindingContext.OpenUrlCommand, Source={x:Reference MyCollectionView}}"
                                        CommandParameter="{Binding Url}"
                                        CornerRadius="21"
                                        HeightRequest="42"
                                        Source="tocar.png"
                                        WidthRequest="42" />

                                    <!--  SELECCIONAR  -->
                                    <CheckBox
                                        HorizontalOptions="Center"
                                        IsChecked="{Binding IsSelected}"
                                        Color="{DynamicResource ColorAcentoOscuro}" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!--  ==================================  -->
            <!--  BOTONES DE DESCARGA  -->
            <!--  ==================================  -->

            <Grid
                Grid.Row="1"
                Padding="12,8"
                ColumnDefinitions="*"
                IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}">

                <!--  DESCARGAR  -->
                <Button
                    Grid.Column="0"
                    BackgroundColor="{DynamicResource ColorAcentoOscuro}"
                    Command="{Binding DownloadCommand}"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    IsVisible="{Binding IsDownloading, Converter={StaticResource InverseBoolConverter}}"
                    Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[Download]}"
                    TextColor="#FFFFFF" />

                <!--  CANCELAR  -->
                <Button
                    Grid.Column="0"
                    BackgroundColor="{DynamicResource ColorError}"
                    Command="{Binding CancelCommand}"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    IsVisible="{Binding IsDownloading}"
                    Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[Cancel]}"
                    TextColor="#FFFFFF" />

            </Grid>

        </Grid>

    </Grid>

</ContentPage>
