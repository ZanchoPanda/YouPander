<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="YouPander.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local2="clr-namespace:YouPander.Services"
    xmlns:resx="clr-namespace:YouPander.Resources.Localization"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[Settings]}"
    BackgroundColor="{DynamicResource ColorFondoPrincipal}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!--  Idioma  -->
            <Label
                FontAttributes="Bold"
                Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[Language]}"
                TextColor="{DynamicResource ColorTextoPrimario}" />

            <Picker
                BackgroundColor="{DynamicResource ColorFondoElevado}"
                SelectedItem="{Binding Settings.Language}"
                TextColor="{DynamicResource ColorTextoPrimario}">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>en</x:String>
                        <x:String>es</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <!--  Ruta  -->
            <Label
                FontAttributes="Bold"
                Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[DownloadPath]}"
                TextColor="{DynamicResource ColorTextoPrimario}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry
                    Grid.Column="0"
                    BackgroundColor="{DynamicResource ColorFondoElevado}"
                    IsReadOnly="True"
                    Placeholder="C:\Users\...\Downloads"
                    PlaceholderColor="{DynamicResource ColorTextoDeshabilitado}"
                    Text="{Binding Settings.DownloadPath}"
                    TextColor="{DynamicResource ColorTextoPrimario}" />

                <Button
                    Grid.Column="1"
                    Command="{Binding BrowseFolderCommand}"
                    Text="📁"
                    WidthRequest="48" />
            </Grid>

            <Grid
                ColumnDefinitions="50,Auto"
                ColumnSpacing="6"
                VerticalOptions="Center">
                <Switch
                    Grid.Column="0"
                    HorizontalOptions="Center"
                    IsToggled="{Binding Settings.OpenDownloads}" />
                <Label
                    Grid.Column="1"
                    Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[OpenDownloadedFolder]}"
                    VerticalOptions="Center" />
            </Grid>

            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Border
                        Padding="12"
                        BackgroundColor="{DynamicResource ColorAcentoMuysuave}"
                        Stroke="{DynamicResource ColorAcentoSuave}"
                        StrokeShape="RoundRectangle 12">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                FontAttributes="Bold"
                                Text="Conf"
                                TextColor="{DynamicResource ColorTextoPrimario}" />

                            <Label
                                Grid.Column="1"
                                FontSize="18"
                                Text="⚙"
                                TextColor="{DynamicResource ColorTextoAcento}" />

                        </Grid>

                    </Border>
                </toolkit:Expander.Header>

                <VerticalStackLayout>

                    <Label
                        Margin="10,4"
                        FontSize="12"
                        Text="{Binding YtDlpVersion, StringFormat='yt-dlp: {0}'}"
                        TextColor="{DynamicResource ColorTextoDeshabilitado}" />

                    <Grid
                        ColumnDefinitions="50,Auto"
                        ColumnSpacing="6"
                        VerticalOptions="Center">

                        <Switch
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            IsToggled="{Binding Settings.AdvancedConfig}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[ActivateAdvancedConfig]}"
                            TextColor="{DynamicResource ColorTextoPrimario}"
                            VerticalOptions="Center" />

                    </Grid>

                    <VerticalStackLayout
                        Padding="12"
                        IsEnabled="{Binding Settings.AdvancedConfig}"
                        Spacing="15">
                        <!--  Dark mode  -->
                        <Grid
                            ColumnDefinitions="50,Auto"
                            ColumnSpacing="6"
                            VerticalOptions="Center">
                            <Switch
                                Grid.Column="0"
                                HorizontalOptions="Center"
                                IsToggled="{Binding Settings.DarkMode}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[DarkMode]}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label
                            FontAttributes="Bold"
                            Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[AudioDownloadPath]}"
                            TextColor="{DynamicResource ColorTextoPrimario}"
                            VerticalOptions="Center" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Button
                                Grid.Column="0"
                                Command="{Binding CleanAudioCommand}"
                                Text="🗑️"
                                WidthRequest="48" />
                            <Entry
                                Grid.Column="1"
                                IsReadOnly="True"
                                Placeholder="C:\Users\...\Downloads\Audio"
                                Text="{Binding Settings.AudioDownloadPath}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding BrowseAudioCommand}"
                                Text="📁"
                                WidthRequest="48" />
                        </Grid>

                        <Label
                            FontAttributes="Bold"
                            Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[VideoDownloadPath]}"
                            TextColor="{DynamicResource ColorTextoPrimario}"
                            VerticalOptions="Center" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Button
                                Grid.Column="0"
                                Command="{Binding CleanVideoCommand}"
                                Text="🗑️"
                                WidthRequest="48" />
                            <Entry
                                Grid.Column="1"
                                IsReadOnly="True"
                                Placeholder="C:\Users\...\Downloads\Video"
                                Text="{Binding Settings.VideoDownloadPath}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding BrowseVideoCommand}"
                                Text="📁"
                                WidthRequest="48" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </toolkit:Expander>

            <!--  Botón guardar  -->
            <Button
                Margin="0,20,0,0"
                Command="{Binding SaveCommand}"
                HorizontalOptions="End"
                MinimumWidthRequest="100"
                Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[Save]}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>