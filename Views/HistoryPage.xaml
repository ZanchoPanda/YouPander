<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="YouPander.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local2="clr-namespace:YouPander.Services"
    Title="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[History]}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid
            Grid.Row="0"
            Margin="10,8,10,6"
            ColumnDefinitions="*,140"
            ColumnSpacing="8">
            <SearchBar
                Grid.Column="0"
                Placeholder="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[Search]}"
                Text="{Binding SearchText}" />
            <Picker
                Grid.Column="1"
                ItemsSource="{Binding FilterOptions}"
                SelectedIndex="{Binding SelectedFilterIndex}" />
        </Grid>

        <CollectionView
            Grid.Row="1"
            Margin="10"
            ItemsSource="{Binding Records}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,6"
                        Padding="10"
                        BackgroundColor="{DynamicResource ColorFondoSuperficie}"
                        Stroke="{DynamicResource ColorBordeNormal}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0.5">

                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="12">

                            <!--  Thumbnail  -->
                            <Grid Grid.Column="0">
                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="80"
                                    Source="{Binding ThumbnailUrl}" />

                                <!--  Badge de formato  -->
                                <Border
                                    Margin="0,0,6,6"
                                    Padding="6,2"
                                    BackgroundColor="#AA000000"
                                    HorizontalOptions="End"
                                    StrokeShape="RoundRectangle 6"
                                    VerticalOptions="End">
                                    <Label
                                        FontSize="10"
                                        Text="{Binding Format}"
                                        TextColor="White" />
                                </Border>
                            </Grid>

                            <!--  Información  -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    MaxLines="2"
                                    Text="{Binding Title}"
                                    TextColor="{DynamicResource ColorTextoPrimario}" />

                                <HorizontalStackLayout Spacing="4">
                                    <Label
                                        FontSize="12"
                                        Text="📺"
                                        VerticalTextAlignment="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="{Binding Channel}"
                                        TextColor="{DynamicResource ColorTextoSecundario}" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="4">
                                    <Label FontSize="12" Text="📅" />
                                    <Label
                                        FontSize="12"
                                        Text="{Binding DownloadedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                        TextColor="{DynamicResource ColorTextoSecundario}" />
                                </HorizontalStackLayout>

                                <Label
                                    FontSize="12"
                                    Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[ShowOriginalVid]}"
                                    TextColor="{DynamicResource ColorInfo}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.OpenUrlCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding}" />
                                    </Label.GestureRecognizers>
                                </Label>

                            </VerticalStackLayout>

                            <!--  Acciones  -->
                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="8"
                                VerticalOptions="Center">

                                <ImageButton
                                    Padding="10"
                                    BackgroundColor="{DynamicResource ColorExito}"
                                    Command="{Binding BindingContext.ReDownloadCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="21"
                                    HeightRequest="42"
                                    Source="descargarflecha.png"
                                    WidthRequest="42" />

                                <ImageButton
                                    Padding="10"
                                    BackgroundColor="{DynamicResource ColorError}"
                                    Command="{Binding BindingContext.DeleteCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="21"
                                    HeightRequest="42"
                                    Source="eliminar.png"
                                    WidthRequest="42" />

                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="2"
            Margin="10,6"
            BackgroundColor="{DynamicResource ColorError}"
            Command="{Binding ClearAllCommand}"
            Text="{Binding Source={x:Static local2:LocalizationResourceManager.Instance}, Path=[ClearAll]}" />

    </Grid>
</ContentPage>